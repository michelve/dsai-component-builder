{
  "name": "dsai-component-builder",
  "version": "1.0.0",
  "description": "Transform design tokens into living components with unprecedented precision. Advanced design system automation for Figma.",
  "main": "code.js",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --outfile=code.js --target=es2017",
    "watch": "esbuild src/code.ts --bundle --outfile=code.js --target=es2017 --watch"
  },
  "author": "michelve",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "^0.16.1",
    "@figma/plugin-typings": "^1.119.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  }
}
