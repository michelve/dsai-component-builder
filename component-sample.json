{
  "componentSet": {
    "name": "Button Primary",
    "key": "primary-button-001",
    "type": "COMPONENT_SET",
    "description": "Bootstrap is primary button. Use for the main call-to-action on a page. Matches Bootstrap 5 styles and variables for .btn-primary.",
    "documentationLink": "https://getbootstrap.com/docs/5.3/components/buttons/#examples"
  },
  "defaultStyles": {
    "label": "Button",
    "fills": "{Foundation/colors/brand/blue/600}",
    "strokes": "{Foundation/colors/brand/blue/700}",
    "strokeWeight": "{Foundation/borders/width/1}",
    "text": "{Foundation/colors/neutral/white}",
    "radius": "{Radius/Base/radius/default}",
    "padding": {
      "top": "{Spacing/Base/spacing/2}",
      "bottom": "{Spacing/Base/spacing/2}",
      "left": "{Spacing/Base/spacing/3}",
      "right": "{Spacing/Base/spacing/3}"
    },
    
    "gap": "{Spacing/Base/spacing/2}",
    "fontName": "{Typography/Base/fontFamily/base}",
    "fontWeight": "{Typography/Base/fontWeight/medium}",
    "fontSize": "{Typography/Base/fontSize/base}",
    "lineHeight": "{Typography/Base/lineHeight/base}",
    "letterSpacing": "{Typography/Base/letterSpacing/normal}",
    "textAlignHorizontal": "CENTER",
    "textAlignVertical": "CENTER",
    "textLayout": {
      "textAutoResize": "WIDTH"
    }
  },
  "variants": [
    {
      "variant": "primary",
      "state": "default",
      "size": "medium",
      "styles": {
        "fills": "{Foundation/colors/brand/blue/600}",
        "strokes": "{Foundation/colors/brand/blue/700}"
      }
    },
    {
      "variant": "primary",
      "state": "hover",
      "size": "medium",
      "styles": {
        "fills": "{Foundation/colors/brand/blue/700}",
        "strokes": "{Foundation/colors/brand/blue/800}"
      },
      "description": "Bootstrap primary hover state. Use for mouse hover or focus-visible."
    },
    {
      "variant": "primary",
      "state": "active",
      "size": "medium",
      "styles": {
        "fills": "{Foundation/colors/brand/blue/800}",
        "strokes": "{Foundation/colors/brand/blue/900}"
      }
    },
    {
      "variant": "primary",
      "state": "disabled",
      "size": "medium",
      "styles": {
        "fills": "{Foundation/colors/neutral/gray/600}",
        "strokes": "{Foundation/colors/neutral/gray/700}",
        "text": "{Foundation/colors/neutral/white}",
        "opacity": "{Foundation/colors/opacity/50}"
      }
    },
    {
      "variant": "secondary",
      "state": "default",
      "size": "medium",
      "styles": {
        "fills": "{Foundation/colors/neutral/white}",
        "strokes": "{Foundation/colors/brand/blue/600}",
        "text": "{Foundation/colors/brand/blue/600}"
      }
    },
    {
      "variant": "secondary",
      "state": "hover",
      "size": "medium",
      "styles": {
        "fills": "{Foundation/colors/brand/blue/100}",
        "strokes": "{Foundation/colors/brand/blue/700}",
        "text": "{Foundation/colors/brand/blue/700}"
      }
    }
  ]
}
